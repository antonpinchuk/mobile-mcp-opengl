# Copy this to .env (git-ignored) in the same directory and fill in real values.

# Which vision provider to use. Built-in options: "runware" (active below),
# "openai", "openrouter", "openai-compatible". See README "Bring your own
# model" for how to add a custom one, and "Switching models if accuracy is
# insufficient" for when to reach for the pricier "openai" option instead.
VISION_PROVIDER=runware

# --- runware provider (VISION_PROVIDER=runware) - ACTIVE DEFAULT ---
# https://runware.ai - get a key from your Runware dashboard. Talks to
# Runware's task-specific `imageCaption` endpoint, which only accepts a
# small, undocumented set of AIR ids - most ids that "look right" (general
# chat model ids, sequential numbers) come back `invalidCaptionModel`.
# Two confirmed working, found by trial against the live API (see README
# "Switching models" for the comparison):
#   - runware:150@2 (LLaVA-1.6-Mistral-7B, default if RUNWARE_VISION_MODEL
#     is unset) - gave correct/coherent answers in every test run in this
#     project's comparison, at the same price as 152@2 (a different model,
#     not a tweak of it) - the recommended default.
#   - runware:152@2 (Qwen2.5-VL-7B-Instruct) - the older default, kept
#     available for comparison. Directly observed answering confidently
#     wrong on a real screenshot in this project's testing - not
#     recommended as a default anymore, see README.
# Cheapest option either way (~$0.0006/short-answer call - see README "Cost
# model" for what a full session costs at this price).
RUNWARE_API_KEY=
# RUNWARE_VISION_MODEL=runware:150@2

# --- openai provider (VISION_PROVIDER=openai) ---
# Despite the name, does NOT require an OpenAI account: defaults to
# Runware's OWN /v1/chat/completions endpoint (same RUNWARE_API_KEY as
# above, no separate account) - a DIFFERENT model registry than the
# `runware` provider's imageCaption task above, using Runware's AIR id
# format (creator:family@version). Point OPENAI_BASE_URL at
# https://api.openai.com/v1 instead (with a real OPENAI_API_KEY) for
# genuinely OpenAI-hosted inference - untested against that path specifically,
# but the request/response shape is the OpenAI standard this provider
# implements directly.
#
# Reach for this only if the `runware` default above isn't accurate enough
# for what you're checking (see README "Switching models") - it costs about
# 10x more per call (~$0.006 vs ~$0.0006) for accuracy that was NOT
# meaningfully better in this project's own side-by-side comparison. Don't
# switch to it by default; it's a deliberate tradeoff for specific cases,
# not a general upgrade.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.runware.ai/v1

# GPT-5.6 Terra - smoke-tested and empirically compared against several
# tiers on real screenshots from this project (see README): correct short
# answers fastest (~1s), respects the short-answer instruction (a handful
# of completion tokens per call, not a paragraph of reasoning). Pricing for
# this exact model is hardcoded as this provider's fallback (see
# openaiProvider.js) so cost tracking works without extra config - only set
# OPENAI_PRICE_PER_1M_INPUT/_OUTPUT below if you change OPENAI_MODEL to a
# different tier.
# OPENAI_MODEL=openai:gpt@5.6-terra

# Other AIR ids confirmed working against Runware's chat endpoint during
# this comparison (see README for the full table) - uncomment at most one
# MODEL/PRICE trio at a time, in place of the Terra one above:
#
# google:gemini@3.6-flash - about the same real cost as Terra in testing
# (cheaper per-token but used far more completion tokens per answer);
# correct on the same test cases.
# OPENAI_MODEL=google:gemini@3.6-flash
# OPENAI_PRICE_PER_1M_INPUT=1.50
# OPENAI_PRICE_PER_1M_OUTPUT=7.50
#
# google:gemini@3.1-pro - stronger reasoning, but ~2x Terra's cost per call
# in testing AND ignores the short-answer instruction (hundreds of
# reasoning tokens on a one-word question) - only worth it if Terra is
# still insufficient for what you're checking.
# OPENAI_MODEL=google:gemini@3.1-pro
# OPENAI_PRICE_PER_1M_INPUT=2.00
# OPENAI_PRICE_PER_1M_OUTPUT=12.00

# --- openrouter provider (VISION_PROVIDER=openrouter) ---
# *** NOT LIVE-TESTED *** - written from OpenRouter's published docs, not
# verified against a real account (no OpenRouter key was available when
# this was added - see README "Switching models" for why). Should work per
# their documented request/response shape; if you try it and it needs a
# fix, a PR is very welcome. Requires a separate account + funded balance
# at https://openrouter.ai (their own model catalog and slug format,
# provider/model - e.g. "qwen/qwen3-vl-30b-a3b-instruct" - NOT Runware's AIR
# format used by the openai/runware providers above).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# (check OpenRouter's current catalog/pricing before committing to a long
# session - model lineups and prices change; ~$0.13/$0.52 per 1M input/
# output tokens as of when this was written, meaningfully cheaper than the
# openai provider's GPT-5.6 Terra default IF its accuracy turns out to be
# sufficient for what you're checking - not verified either way here)

# --- openai-compatible provider (VISION_PROVIDER=openai-compatible) ---
# Generic escape hatch for anything else speaking the OpenAI chat-
# completions vision format that isn't covered by a dedicated provider
# above: a local Ollama/LM Studio server, Groq, Together.ai, or OpenRouter
# itself if you'd rather configure it here by hand instead of using the
# dedicated `openrouter` provider.
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# Optional: only set these if you want this provider to estimate costUsd
# from response token usage (most OpenAI-compatible APIs report tokens, not
# a flat dollar cost per call).
# OPENAI_COMPATIBLE_PRICE_PER_1M_INPUT=
# OPENAI_COMPATIBLE_PRICE_PER_1M_OUTPUT=

# --- adb ---
# Only needed if `adb` isn't on PATH, or you have more than one device/
# emulator attached and need to target a specific one (`adb devices` to list
# serials).
# ADB_PATH=/path/to/adb
# ADB_DEVICE_SERIAL=emulator-5554

# --- Spend guardrails (provider-agnostic) ---
# Per-call alert threshold in USD - logged to stderr, doesn't block the call.
# VISION_ALERT_USD=0.0015
# Cumulative today's-spend cap in USD - calls are refused once reached.
# VISION_SESSION_CAP_USD=2.00
# Where to write the spend log (JSONL, one entry per vision call).
# VISION_LOG_PATH=.data/vision-log.jsonl
